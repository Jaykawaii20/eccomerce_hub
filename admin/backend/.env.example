# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ─── Supabase ──────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Get from: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# ─── Database (Prisma) ─────────────────────────────────
# Pooler URL (Transaction mode) — for runtime queries
# Get from: Supabase Dashboard → Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct URL — for prisma migrate only
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ─── Upstash Redis ─────────────────────────────────────
# Get from: console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── Supabase Storage ──────────────────────────────────
SUPABASE_STORAGE_BUCKET_PRODUCTS=product-images
SUPABASE_STORAGE_BUCKET_DOWNLOADS=secure-downloads
SUPABASE_STORAGE_BUCKET_MEDIA=media

# ─── Email (SMTP) ──────────────────────────────────────
# Option 1: Use Supabase SMTP (Settings → Auth → SMTP)
# Option 2: SendGrid / Brevo / Mailgun
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
EMAIL_FROM="My Store <noreply@mystore.com>"

# ─── Stripe ────────────────────────────────────────────
# Get from: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_
# Get from: Stripe Dashboard → Webhooks → Add endpoint
STRIPE_WEBHOOK_SECRET=whsec_

# ─── App URLs ──────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
MOBILE_APP_DEEP_LINK_SCHEME=shop
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Monitoring ────────────────────────────────────────
# Get from: sentry.io → Create Project → DSN
SENTRY_DSN=
LOG_LEVEL=debug
